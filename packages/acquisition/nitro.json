{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["acquisition"],
  "ios": {
    "iosModuleName": "NitroAcquisition"
  },
  "android": {
    "androidNamespace": ["acquisition"],
    "androidCxxLibName": "NitroAcquisition"
  },
  "autolinking": {
    "Acquisition": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridAcquisition"
      }
    },
    "CameraPreview": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridCameraPreview"
      }
    },
    "RPPG": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridRPPG"
      }
    },
    "RPPGPreview": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridRPPGPreview"
      }
    },
    "PassiveCapture": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridPassiveCapture"
      }
    },
    "SensorCapture": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridSensorCapture"
      }
    }
  },
  "ignorePaths": ["**/node_modules", "nitrogen/generated"],
  "gitAttributesGeneratedFlag": false
}
