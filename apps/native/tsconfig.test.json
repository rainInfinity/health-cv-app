    "src/app/startup/startupFlow.ts",
    "src/pages/measurement/FingertipMeasurement/fingertipPresentation.ts",
    "src/pages/measurement/FingertipMeasurement/useFingertipMeasurement.ts",
    "src/pages/measurement/BloodPressureMeasurement/bloodPressurePresentation.ts",
