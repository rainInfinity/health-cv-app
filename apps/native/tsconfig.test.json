{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "resolveJsonModule": true,
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "noEmit": false,
    "outDir": "./node_modules/.cache/native-test",
    "rootDir": "./src"
  },
  "include": [
    "src/app/navigation/acquisitionLeaveGuard.ts",
    "src/app/navigation/rppgNavigationGuard.ts",
    "src/app/lifecycle/appStateEvents.ts",
